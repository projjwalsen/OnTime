# ============================================================
# OnTime — .gitignore
# ============================================================

# ------ Dependencies ------
node_modules/
.pnp
.pnp.js

# ------ Build Outputs ------
dist/
build/
out/
.next/
.expo/
*.tsbuildinfo

# ------ Environment / Secrets ------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# ------ Logs ------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------ Prisma ------
# Keep migrations in source control; exclude generated client
apps/backend/node_modules/
apps/backend/src/generated/

# ------ Testing ------
coverage/
.nyc_output/

# ------ IDEs & Editors ------
.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ------ OS ------
.DS_Store
.AppleDouble
.LSOverride
Desktop.ini
$RECYCLE.BIN/

# ------ Miscellaneous ------
*.pem
*.key
*.cert
tmp/
temp/

# ------ API Clients & Postman ------
postman/
*.postman_collection.json

# scripts/
# *.tsbuildinfo
# *.ts