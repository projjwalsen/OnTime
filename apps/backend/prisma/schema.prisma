// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

// Platform-wide user role hierarchy.
//
// SUPER_ADMIN — Platform administrator / owner. Has no organisationId.
//               Manages all retailer organisations, products, categories, orders.
//
// ADMIN       — Primary administrator of a single retailer organisation.
//               Can invite staff to their own organisation.
//
// STAFF       — Standard staff member of a single retailer organisation.
//               Cannot invite users or create/manage organisations.
enum UserRole {
  SUPER_ADMIN
  ADMIN
  STAFF
}


// Lifecycle states of an organisation invitation.
enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

// Operational status of a retailer organisation.
// Managed exclusively by the distributor.
enum OrganisationStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

// Purpose of a generated One-Time Password (OTP)
enum OtpPurpose {
  LOGIN
  PASSWORD_RESET
  REGISTRATION
}

// Lifecycle states of a retailer order.
enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
}

// ============================================================
// ORGANISATION
// Represents a retailer/customer company onboarded by the platform.
//
// DATA OWNERSHIP: This is a RETAILER-LEVEL entity.
// The platform owner is NOT modelled as an Organisation.
// Platform owner users are identified by UserRole.SUPER_ADMIN.
// ============================================================


model Organisation {
  id        String             @id @default(uuid())
  name      String
  email     String             @unique
  mobile    String?
  address   String?
  area      String?
  city      String?
  taxNumber String?
  status    OrganisationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  // Relations
  users       User[]
  invitations OrganisationInvitation[]
  orders      Order[]
  draftOrders DraftOrder[]

  @@map("organisations")
}

// ============================================================
// USER
// Represents both platform-side and retailer-side users.
//
// IMPORTANT: organisationId is NULL for SUPER_ADMIN users.
//            organisationId is REQUIRED for ADMIN and STAFF.
//
// The email is globally unique as it serves as the platform login identity.
//
// DATA OWNERSHIP:
//   - SUPER_ADMIN: Platform-level (no org)
//   - ADMIN / STAFF: Retailer organisation-level
// ============================================================

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  passwordHash   String
  name           String
  mobile         String?
  role           UserRole
  // null for SUPER_ADMIN; always set for organisation users
  organisationId String?

  isActive           Boolean        @default(true)
  mustChangePassword Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  // Relations
  organisation        Organisation?         @relation(fields: [organisationId], references: [id])
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  createdOrders       Order[]
  createdDraftOrders  DraftOrder[]

  @@index([organisationId])
  @@index([role])
  @@map("users")
}

// ============================================================
// REFRESH TOKEN
// Tracks active and revoked JWT refresh tokens for secure session management.
// ============================================================

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ============================================================
// PASSWORD RESET TOKEN
// Tracks temporary tokens for forgotten password resets.
// ============================================================

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

// ============================================================
// OTP CODE
// Tracks one-time passwords for email verification (login, password reset).
// ============================================================

model OtpCode {
  id        String     @id @default(uuid())
  email     String
  codeHash  String
  purpose   OtpPurpose
  expiresAt DateTime
  attempts  Int        @default(0)
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  @@index([email, purpose])
  @@map("otp_codes")
}

// ============================================================
// ORGANISATION INVITATION
// Tracks invitations sent by an ADMIN to join their organisation.
//
// RULES:
//   - Only ADMIN can create invitations.
//   - STAFF can NEVER create invitations.
//   - Invitable roles: ADMIN, STAFF only.
//   - SUPER_ADMIN is never created via invitations.
//
// DATA OWNERSHIP: Retailer organisation-level.
// ============================================================

model OrganisationInvitation {
  id             String           @id @default(uuid())
  organisationId String
  email          String
  // Only ADMIN or STAFF are valid here.
  // SUPER_ADMIN must never appear as an invitation role.
  role           UserRole

  token          String           @unique
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Relations
  organisation Organisation @relation(fields: [organisationId], references: [id])

  @@unique([email, organisationId])
  @@index([organisationId])
  @@index([token])
  @@index([status])
  @@map("organisation_invitations")
}

// ============================================================
// CATEGORY
// Product categories managed exclusively by the distributor.
// DATA OWNERSHIP: DISTRIBUTOR-LEVEL entity (no organisationId).
// ============================================================

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@map("categories")
}

// ============================================================
// PRODUCT
// Distributor product catalog.
// DATA OWNERSHIP: DISTRIBUTOR-LEVEL entity (no organisationId).
// ============================================================

model Product {
  id          String    @id @default(uuid())
  name        String
  sku         String    @unique
  description String?
  price       Decimal   @db.Decimal(10, 2)
  categoryId  String?
  unit          String    @default("piece")
  isActive      Boolean   @default(true)
  images        String[]  @default([])
  packagingNote String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants        ProductVariant[]
  orderItems      OrderItem[]
  draftOrderItems DraftOrderItem[]

  @@index([categoryId])
  @@index([sku])
  @@map("products")
}

// ============================================================
// PRODUCT VARIANT
// Specific package/size/weight/pricing variations for a product.
// DATA OWNERSHIP: Inherits distributor-level ownership from Product.
// ============================================================

model ProductVariant {
  id          String      @id @default(uuid())
  productId   String
  weight      String?
  description String?
  image       String?
  price       Decimal     @db.Decimal(10, 2)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]
  draftOrderItems DraftOrderItem[]

  @@index([productId])
  @@map("product_variants")
}

// ============================================================
// ORDER
// Represents a wholesale order placed by a retailer organisation.
//
// DATA OWNERSHIP: Retailer organisation-level entity.
// ============================================================

model Order {
  id                 String       @id @default(uuid())
  orderNumber        String       @unique
  organisationId     String
  createdByUserId    String
  status             OrderStatus  @default(PENDING)
  subtotal           Decimal      @db.Decimal(10, 2)
  taxAmount          Decimal      @default(0.00) @db.Decimal(10, 2)
  totalAmount        Decimal      @db.Decimal(10, 2)
  notes              String?
  deliveryAddress    String?
  cancellationReason String?
  cancelledAt        DateTime?
  deliveredAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // Relations
  organisation       Organisation @relation(fields: [organisationId], references: [id])
  createdBy          User         @relation(fields: [createdByUserId], references: [id])
  items              OrderItem[]

  @@index([organisationId])
  @@index([createdByUserId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
  @@map("orders")
}

// ============================================================
// ORDER ITEM
// Line items in an order with point-in-time price snapshotting.
//
// DATA OWNERSHIP: Scoped through Order.
// ============================================================

model OrderItem {
  id            String          @id @default(uuid())
  orderId       String
  productId     String
  variantId     String?
  productName   String
  productSku    String
  variantWeight String?
  unitPrice     Decimal         @db.Decimal(10, 2)
  quantity      Int
  totalPrice    Decimal         @db.Decimal(10, 2)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Relations
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [productId], references: [id])
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

// ============================================================
// DRAFT ORDER
// Represents an unsubmitted / work-in-progress order created by a retailer.
//
// DATA OWNERSHIP: Retailer organisation-level entity.
// ============================================================

model DraftOrder {
  id              String           @id @default(uuid())
  organisationId  String
  createdByUserId String
  title           String?
  notes           String?
  deliveryAddress String?
  subtotal        Decimal          @default(0.00) @db.Decimal(10, 2)
  taxAmount       Decimal          @default(0.00) @db.Decimal(10, 2)
  totalAmount     Decimal          @default(0.00) @db.Decimal(10, 2)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relations
  organisation    Organisation     @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  createdBy       User             @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  items           DraftOrderItem[]

  @@index([organisationId])
  @@index([createdByUserId])
  @@index([createdAt])
  @@map("draft_orders")
}

// ============================================================
// DRAFT ORDER ITEM
// Line items in a draft order.
//
// DATA OWNERSHIP: Scoped through DraftOrder.
// ============================================================

model DraftOrderItem {
  id            String          @id @default(uuid())
  draftOrderId  String
  productId     String
  variantId     String?
  productName   String
  productSku    String
  variantWeight String?
  unitPrice     Decimal         @db.Decimal(10, 2)
  quantity      Int             @default(1)
  totalPrice    Decimal         @db.Decimal(10, 2)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  // Relations
  draftOrder    DraftOrder      @relation(fields: [draftOrderId], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([draftOrderId])
  @@index([productId])
  @@index([variantId])
  @@map("draft_order_items")
}




