{
  "name": "@ontime/backend",
  "version": "1.0.0",
  "private": true,
  "description": "OnTime API — Node.js + Express + TypeScript backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:format": "prisma format",
    "prisma:seed": "tsx prisma/seed.ts",
    "seed": "tsx prisma/seed.ts",
    "test:auth": "tsx src/tests/auth.test.ts",
    "test:products": "tsx src/tests/products.test.ts",
    "test:orders": "tsx src/tests/orders.test.ts",
    "test:draft-orders": "tsx src/tests/draft_orders.test.ts",
    "test:pagination": "tsx src/tests/pagination_and_filters.test.ts",
    "test:media": "tsx src/tests/media_upload.test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ontime/shared": "*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/config": "^7.10.0",
    "@supabase/supabase-js": "^2.116.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.5.4",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.3",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "typescript": "^5.5.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/multer": "^2.2.0",
    "tsx": "^4.19.1"
  }
}
